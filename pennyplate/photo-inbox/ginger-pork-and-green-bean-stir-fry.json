{
 "id": "ginger-pork-and-green-bean-stir-fry",
 "title": "Ginger Pork & Green Bean Stir-Fry",
 "summary": "Savory-sweet ground pork with blistered green beans in a garlicky ginger sauce, ready in 25 minutes over rice.",
 "ingredients": [
  "1 ½ cups jasmine rice",
  "2 tbsp vegetable oil",
  "1 lb green beans, trimmed and cut into 2-inch pieces",
  "1 lb ground pork",
  "3 cloves garlic, minced",
  "1 tbsp grated ginger",
  "3 tbsp soy sauce",
  "1 tbsp hoisin sauce",
  "1 tbsp rice vinegar",
  "1 tbsp brown sugar",
  "1 tbsp cornstarch",
  "¼ cup water",
  "1 tsp sesame oil",
  "¼ tsp red pepper flakes",
  "2 green onions, sliced"
 ],
