{
 "id": "chipotle-tofu-rice-bowls",
 "title": "Chipotle Tofu & Rice Bowls with Corn Salsa",
 "summary": "Crispy spiced tofu over rice and black beans with a fresh lime-corn salsa.",
 "ingredients": [
  "14 oz firm tofu",
  "2 tbsp vegetable oil",
  "1 tbsp chipotle in adobo, minced",
  "1 tsp chili powder",
  "1 tsp ground cumin",
  "1 tsp salt",
  "1 ½ cups long grain rice",
  "2 (15 oz) cans black beans, drained",
  "1 ½ cups frozen corn",
  "1 red onion, finely diced",
  "1 lime",
  "¼ cup chopped cilantro",
  "2 avocados, sliced"
