 "id": "shrimp-masala-peas-basmati",
 "title": "Shrimp Masala with Peas & Basmati",
 "summary": "Plump shrimp simmered in a spiced tomato-onion masala with sweet peas, ready in 25 minutes.",
 "ingredients": [
  "1 ½ cups basmati rice",
