  "1 tsp ground turmeric",
  "1 tsp ground cumin",
  "½ tsp cayenne pepper",
  "1 (14.5 oz) can diced tomatoes",
  "½ cup water",
  "1 lb shrimp, peeled and thawed",
  "1 cup frozen peas",
  "1 tsp salt",
  "1 lemon",
  "¼ cup chopped cilantro"
