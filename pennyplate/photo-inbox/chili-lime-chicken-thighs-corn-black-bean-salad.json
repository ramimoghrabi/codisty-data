  "3 limes",
  "3 tbsp olive oil",
  "2 (15 oz) cans black beans, drained and rinsed",
  "1 ½ cups frozen corn, thawed",
  "1 red onion, finely diced",
  "1 avocado, diced",
  "¼ cup chopped cilantro"
