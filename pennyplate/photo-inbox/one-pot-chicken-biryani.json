{
 "id": "one-pot-chicken-biryani",
 "title": "One-Pot Chicken Biryani",
 "summary": "Fragrant spiced rice cooked with yogurt-marinated chicken and sweet golden onions.",
 "ingredients": [
  "2 lb bone-in chicken thighs",
  "¾ cup plain yogurt",
  "1 tbsp grated ginger",
  "4 cloves garlic, minced",
  "2 tsp garam masala",
  "1 tsp ground turmeric",
  "1 tsp ground cumin",
  "1 tsp paprika",
  "1 ½ tsp salt",
  "3 tbsp vegetable oil",
  "2 onions, thinly sliced",
  "2 cups basmati rice",
  "3 cups water",
  "½ cup raisins",
  "¼ cup chopped cilantro",
  "¼ cup fresh mint"
 ],
