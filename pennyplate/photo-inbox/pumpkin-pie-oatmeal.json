 "title": "Pumpkin Pie Oatmeal",
 "summary": "Creamy stovetop oats with pumpkin, cinnamon and crunchy walnuts. Tastes like dessert for pennies.",
 "ingredients": [
  "2 cups rolled oats",
  "2 cups milk",
  "2 cups water",
  "1 (15 oz) can pumpkin purée",
  "2 tbsp brown sugar",
  "1 tsp ground cinnamon",
  "¼ tsp ground nutmeg",
  "¼ tsp salt",
  "1 tsp vanilla extract",
  "¼ cup chopped walnuts"
