 "id": "slow-cooker-beef-stew",
 "title": "Slow-Cooker Beef Stew",
 "summary": "Fork-tender beef, potatoes and carrots in a rich, savory gravy that cooks itself all day while you're out.",
 "ingredients": [
  "2 lb beef stew meat",
  "1 ½ lb potatoes, cut into chunks",
  "4 carrots, cut into chunks",
  "1 onion, chopped",
  "3 cloves garlic, minced",
  "2 tbsp tomato paste",
  "3 cups chicken broth",
  "1 tbsp white vinegar",
  "1 tsp Italian seasoning",
  "2 bay leaves",
  "1 tsp salt",
  "½ tsp black pepper",
  "2 tbsp cornstarch",
  "2 tbsp water",
  "1 cup frozen peas"
 ],
