{
 "id": "eggplant-lentil-parmesan-bake",
 "title": "Eggplant & Lentil Parmesan Bake",
 "summary": "Roasted eggplant layered with garlicky tomato lentils and two cheeses, a meatless parmesan with serious staying power.",
 "ingredients": [
  "2 eggplants, sliced into ½-inch rounds",
  "3 tbsp olive oil",
  "1 cup brown lentils",
  "2 cups water",
  "1 onion, diced",
  "4 cloves garlic, minced",
  "1 (28 oz) can crushed tomatoes",
  "1 tsp dried oregano",
  "1 tsp salt",
  "½ tsp black pepper",
  "8 oz shredded mozzarella",
  "2 oz parmesan cheese, grated"
 ],
