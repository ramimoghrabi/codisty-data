{
 "id": "chicken-cacciatore-rice",
 "title": "Easy Chicken Cacciatore over Rice",
 "summary": "Chicken thighs braised in a rustic tomato, pepper and mushroom sauce with olives, spooned over fluffy rice.",
 "ingredients": [
  "1 ½ lb boneless chicken thighs",
  "1 tbsp olive oil",
  "1 onion, sliced",
  "2 bell peppers, sliced",
  "8 oz mushrooms, sliced",
  "4 cloves garlic, minced",
  "½ cup white wine",
  "1 (28 oz) can crushed tomatoes",
  "1 tsp dried oregano",
  "1 tsp Italian seasoning",
  "¼ cup olives, sliced",
  "1 ½ tsp salt",
  "½ tsp black pepper",
  "1 ½ cups long grain rice",
  "3 cups water",
  "¼ cup chopped parsley"
 ],
