 "title": "Creamy Pumpkin Sausage Pasta",
 "summary": "A blushing pumpkin-tomato cream sauce with browned sausage, tossed through penne. Cozy fall comfort for about $2 a serving.",
 "ingredients": [
  "12 oz penne",
  "1 lb Italian sausage",
  "1 onion, finely diced",
  "3 cloves garlic, minced",
  "2 tbsp tomato paste",
  "1 (15 oz) can pumpkin purée",
  "1 cup chicken broth",
  "½ cup heavy cream",
  "½ cup grated parmesan",
  "¼ tsp cayenne pepper",
  "½ tsp dried oregano",
  "1 tsp salt",
  "½ tsp black pepper"
 ],
