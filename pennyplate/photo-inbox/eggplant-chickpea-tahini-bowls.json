 "title": "Roasted Eggplant & Chickpea Bowls with Lemon Tahini",
 "summary": "Sheet-pan eggplant, chickpeas and tomatoes over rice with a lemony tahini drizzle.",
 "ingredients": [
  "1 ½ cups long grain rice",
  "2 eggplants, cut into 1-inch cubes",
  "2 (15 oz) cans chickpeas, drained",
  "10 oz cherry tomatoes",
  "1 red onion, cut into wedges",
  "4 tbsp olive oil",
  "1 tsp ground cumin",
  "1 tsp paprika",
  "1 ¼ tsp salt",
  "⅓ cup tahini",
  "2 lemons",
  "1 clove garlic, minced",
  "⅓ cup water",
  "¼ cup chopped parsley"
 ],
