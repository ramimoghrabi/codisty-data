 "title": "One-Pan Garlic & Herb Chicken Thighs with Rice",
 "summary": "Crisp-skinned chicken thighs bake on a bed of garlicky rice and carrots that soaks up all the juices. One pan, no fuss.",
 "ingredients": [
  "2 lb bone-in chicken thighs",
  "2 tbsp olive oil",
  "1 tsp paprika",
  "1 tsp dried thyme",
  "1 ½ tsp salt",
  "½ tsp black pepper",
  "1 onion, diced",
  "6 cloves garlic, minced",
  "2 carrots, sliced",
  "1 ½ cups long grain rice",
  "3 cups chicken broth",
  "1 lemon",
  "¼ cup chopped parsley"
 ],
