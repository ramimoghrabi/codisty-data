{
 "id": "crispy-tofu-egg-rice-bowls",
 "title": "Crispy Tofu & Scrambled Egg Rice Bowls",
 "summary": "Pan-crisped tofu and soft scrambled eggs over rice with a garlicky soy glaze.",
 "ingredients": [
  "1 ½ cups jasmine rice",
  "2 (14 oz) blocks extra firm tofu, cubed",
  "1 tbsp cornstarch",
  "3 tbsp vegetable oil",
  "6 eggs, beaten",
  "3 cloves garlic, minced",
  "1 tbsp grated ginger",
  "3 tbsp soy sauce",
  "1 tbsp honey",
  "1 tbsp rice vinegar",
  "1 cup frozen peas",
  "3 green onions, sliced"
