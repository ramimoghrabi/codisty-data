  "3 tbsp teriyaki sauce",
  "1 tbsp soy sauce",
  "1 tbsp honey",
  "2 cups frozen broccoli",
  "1 tbsp sesame oil",
  "2 green onions, sliced",
  "1 tbsp sesame seeds"
