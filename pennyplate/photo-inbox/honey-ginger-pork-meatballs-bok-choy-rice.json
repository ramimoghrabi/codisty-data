  "3 tbsp soy sauce",
  "2 tbsp honey",
  "1 tbsp rice vinegar",
  "2 tsp cornstarch",
  "1 tsp sesame oil",
  "1 ½ cups long grain rice",
  "2 ¼ cups water",
  "1 lb bok choy, chopped",
  "1 tbsp vegetable oil"
 ],
