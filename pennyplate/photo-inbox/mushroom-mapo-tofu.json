  "1 tbsp grated ginger",
  "3 (14 oz) blocks firm tofu, cut into ¾-inch cubes",
  "2 tbsp gochujang",
  "2 tbsp soy sauce",
  "1 tsp sugar",
  "1 cup water",
  "1 tbsp cornstarch",
  "1 tsp sesame oil",
  "3 green onions, sliced",
  "½ cup roasted peanuts, chopped"
 ],
