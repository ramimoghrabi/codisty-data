{
 "id": "mushroom-mapo-tofu",
 "title": "Mushroom Mapo-Style Tofu",
 "summary": "Silky tofu and browned mushrooms in a spicy, savory sauce over rice. Meatless but packed with protein.",
 "ingredients": [
  "1 ½ cups long grain rice",
  "2 tbsp vegetable oil",
  "8 oz mushrooms, finely chopped",
