 "title": "Avgolemono (Greek Lemon Chicken & Orzo Soup)",
 "summary": "Silky Greek lemon-egg soup with tender chicken, orzo and vegetables. Cozy, bright and gentle enough for the whole family.",
 "ingredients": [
  "1 tbsp olive oil",
  "1 onion, diced",
  "2 carrots, diced",
  "2 stalks celery, diced",
  "3 cloves garlic, minced",
  "1 lb chicken breast",
  "4 cups chicken broth",
  "2 cups water",
  "1 tsp dried oregano",
  "1 cup orzo",
  "3 eggs",
  "2 lemons",
  "¼ cup chopped parsley",
  "1 tsp salt",
  "½ tsp black pepper"
 ],
