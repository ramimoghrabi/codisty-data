{
 "id": "kung-pao-tofu-rice-bowls",
 "title": "Kung Pao Tofu & Peanut Rice Bowls",
 "summary": "Crispy tofu and peppers in a sweet, tangy, lightly spicy sauce with crunchy peanuts.",
 "ingredients": [
  "1 ½ cups jasmine rice",
  "28 oz firm tofu, pressed and cubed",
  "3 tbsp cornstarch",
  "3 tbsp vegetable oil",
  "1 bell pepper, diced",
  "4 green onions, sliced",
  "4 cloves garlic, minced",
  "1 tbsp grated ginger",
  "1 cup roasted peanuts",
  "3 tbsp soy sauce",
  "2 tbsp rice vinegar",
  "1 tbsp sugar",
  "1 tsp crushed red pepper",
  "1 tsp sesame oil",
  "½ cup water"
 ],
