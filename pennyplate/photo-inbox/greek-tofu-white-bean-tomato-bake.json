{
 "id": "greek-tofu-white-bean-tomato-bake",
 "title": "Greek-Style Tofu & White Bean Tomato Bake with Feta",
 "summary": "Golden tofu and creamy white beans baked in an oregano tomato sauce under salty feta, served over fluffy rice.",
 "ingredients": [
  "2 (14 oz) blocks firm tofu",
  "2 tbsp olive oil",
  "1 onion, diced",
  "4 cloves garlic, minced",
  "1 tbsp dried oregano",
  "1 tsp paprika",
  "1 (28 oz) can crushed tomatoes",
  "2 (15 oz) cans white beans, drained",
  "1 tsp salt",
  "½ tsp black pepper",
  "1 lemon",
  "6 oz feta cheese, crumbled",
  "½ cup chopped parsley",
  "1 ½ cups long grain rice"
 ],
