  "1 tsp paprika",
  "½ tsp ground cinnamon",
  "1 ½ tsp salt",
  "½ tsp black pepper",
  "3 tbsp olive oil",
  "1 cup water",
  "1 cup basmati rice",
  "¼ cup chopped parsley"
