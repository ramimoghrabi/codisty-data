  "1 tsp paprika",
  "½ tsp ground cinnamon",
  "1 ½ tsp salt",
  "½ tsp black pepper",
  "1 ½ cups water",
  "1 lemon",
  "½ cup green olives",
  "¼ cup chopped cilantro",
  "¼ cup chopped parsley",
  "1 ½ cups long grain rice"
