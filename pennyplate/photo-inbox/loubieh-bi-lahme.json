{
 "id": "loubieh-bi-lahme",
 "title": "Loubieh bi Lahme (Green Bean & Beef Stew)",
 "summary": "Tender green beans in a tomato-beef stew with vermicelli rice.",
 "ingredients": [
  "1 lb beef stew meat, cubed",
  "2 tbsp olive oil",
  "1 onion, diced",
  "4 cloves garlic, minced",
  "2 (12 oz) bags frozen green beans",
  "2 tbsp tomato paste",
  "1 (28 oz) can crushed tomatoes",
  "1 tsp seven spice",
  "1 ½ tsp salt",
  "2 tbsp butter",
  "½ cup vermicelli",
  "1 ½ cups long grain rice"
 ],
