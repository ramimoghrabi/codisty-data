 "title": "Aloo Matar (Potato & Pea Curry)",
 "summary": "Tender potatoes and sweet peas in a spiced tomato gravy, served over basmati rice.",
 "ingredients": [
  "2 tbsp vegetable oil",
  "1 onion, finely diced",
  "4 cloves garlic, minced",
  "1 tbsp grated ginger",
  "1 jalapeño, minced",
  "1 tsp ground cumin",
  "1 tsp ground coriander",
  "1 tsp ground turmeric",
  "½ tsp cayenne pepper",
  "1 tbsp garam masala",
  "1 (14.5 oz) can diced tomatoes",
  "1 ½ lb potatoes, cut into ¾-inch cubes",
  "1 ½ cups water",
  "1 ½ tsp salt",
  "1 ½ cups frozen peas",
  "¼ cup chopped cilantro",
  "1 ½ cups basmati rice"
 ],
