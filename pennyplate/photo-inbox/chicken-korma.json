  "1 tbsp garam masala",
  "1 tsp ground coriander",
  "1 tsp ground turmeric",
  "½ tsp cayenne pepper",
  "1 tbsp tomato paste",
  "¼ cup slivered almonds",
  "1 cup water",
  "1 ¼ tsp salt",
  "¼ cup chopped cilantro",
  "1 ½ cups basmati rice"
