  "4 green onions, sliced",
  "1 cucumber, thinly sliced",
  "2 tbsp rice vinegar",
  "1 tsp sugar",
  "½ tsp salt",
  "2 carrots, grated",
  "4 eggs",
  "1 tbsp vegetable oil",
  "1 tbsp sesame seeds"
