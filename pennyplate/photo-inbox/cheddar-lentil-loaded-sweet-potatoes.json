  "1 tsp paprika",
  "1 tsp chili powder",
  "1 (15 oz) can black beans, drained",
  "1 tsp salt",
  "6 oz cheddar cheese, shredded",
  "1 cup plain yogurt",
  "1 lemon",
  "2 green onions, sliced"
 ],
