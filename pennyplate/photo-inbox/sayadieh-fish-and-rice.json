  "4 tbsp vegetable oil",
  "4 onions, thinly sliced",
  "1 ½ cups long grain rice",
  "½ tsp ground allspice",
  "1 bay leaf",
  "3 cups water",
  "¼ cup sliced almonds",
  "1 lemon",
  "¼ cup chopped parsley"
