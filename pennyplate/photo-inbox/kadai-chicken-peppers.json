 "title": "Kadai Chicken with Peppers & Basmati",
 "summary": "Chicken simmered with sizzling bell peppers, onion and toasted spices in a thick tomato masala. On the table in 30 minutes.",
 "ingredients": [
  "1 ½ lb chicken breast, cut into bite-size cubes",
  "2 tbsp vegetable oil",
  "1 onion, sliced",
  "2 bell peppers, cut into strips",
  "4 cloves garlic, minced",
  "1 tbsp grated ginger",
  "1 jalapeño, sliced",
  "2 tsp ground coriander",
  "2 tsp ground cumin",
  "2 tsp garam masala",
  "1 tsp paprika",
  "1 tsp salt",
  "1 (14.5 oz) can diced tomatoes",
  "2 tbsp tomato paste",
  "¼ cup chopped cilantro",
  "1 ½ cups basmati rice",
  "3 cups water"
 ],
